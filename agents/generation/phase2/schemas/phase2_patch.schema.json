{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://albilich.local/schemas/phase2_patch.schema.json",
  "title": "Albilich Patch Schema v3",
  "type": "object",
  "required": ["schema_version", "problem_id", "base_revision", "actor_role", "operations"],
  "additionalProperties": true,
  "x-albilich-authority-contract": {
    "created_id_field_by_operation": {
      "add_claim": "claim_id",
      "add_route": "route_id",
      "add_inference": "inference_id",
      "add_debt": "debt_id",
      "add_proof_obligation": "proof_obligation_id",
      "attach_artifact": "artifact_id",
      "cache_retrieval_card": "card_id",
      "request_context_entity": "request_id"
    },
    "entity_reference_fields": [
      "artifact_id",
      "claim_id",
      "conclusion_claim_id",
      "conclusion_id",
      "debt_id",
      "error_artifact_id",
      "inference_id",
      "owner_id",
      "proof_obligation_id",
      "requested_entity_id",
      "route_id",
      "suggested_next_target",
      "supersedes_artifact_id",
      "target_id",
      "target_claim_id"
    ],
    "entity_reference_list_fields": [
      "add_evidence_artifact_ids",
      "condition_claim_ids",
      "condition_ids",
      "dependency_artifact_ids",
      "evidence_artifact_ids",
      "output_artifact_ids",
      "parent_ids",
      "premise_claim_ids",
      "premise_ids",
      "replacement_claim_ids",
      "resolved_debt_ids",
      "resolved_proof_obligation_ids",
      "resolution_evidence_artifact_ids",
      "source_artifact_ids"
    ],
    "opaque_identifier_fields": ["request_id", "run_id"]
  },
  "properties": {
    "schema_version": {"const": 3},
    "patch_id": {"type": "string"},
    "problem_id": {"type": "string", "minLength": 1},
    "base_revision": {"type": "integer", "minimum": 0},
    "actor_role": {"type": "string", "minLength": 1},
    "target_id": {"type": "string"},
    "evidence_artifact_ids": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "additionalProperties": true,
        "properties": {
          "op": {
            "enum": [
              "attach_artifact",
              "add_claim",
              "add_route",
              "add_inference",
              "add_debt",
              "update_debt",
              "resolve_debt",
              "add_proof_obligation",
              "update_proof_obligation",
              "resolve_proof_obligation",
              "refute_proof_obligation",
              "propose_status_transition",
              "record_run_metrics",
              "mark_publication_review_escalated",
              "abandon_route",
              "reactivate_route",
              "request_context_entity",
              "cancel_context_request",
              "set_claim_assurance",
              "cache_retrieval_card",
              "certify_external_citation"
            ]
          }
        }
      }
    }
  }
}
